# ---------- LLM provider: "gemini" or "ollama" (local) ----------
LLM_PROVIDER=gemini

# Gemini (free key from aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Ollama (only used if LLM_PROVIDER=ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Local Hugging Face models (downloaded on first use) ----------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# ---------- Chunking (characters) ----------
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------- Retrieval ----------
FAISS_TOP_K=20
BM25_TOP_K=20
CANDIDATE_LIMIT=20
RERANK_TOP_K=4
MIN_RERANK_SCORE=-2.0

# ---------- Uploads ----------
MAX_UPLOAD_MB=25

# ---------- LangSmith (free key at smith.langchain.com). Keep false until you have a key ----------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag