# ── Backend: FastAPI + LangGraph ──────────────────────────────────────────────
FROM python:3.12-slim AS backend

WORKDIR /app

# System deps needed by faiss and sentence-transformers
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libgomp1 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy dependency manifests first for layer caching
COPY pyproject.toml uv.lock ./

# Install all deps into a venv at /app/.venv
RUN uv sync --frozen --no-dev

# Copy application source
COPY backend/ ./backend/

# Create persistent data directories (populated at runtime via volume)
RUN mkdir -p data/documents data/indexes

EXPOSE 8001

# Use uv run so the venv is automatically activated
CMD ["uv", "run", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8001"]
